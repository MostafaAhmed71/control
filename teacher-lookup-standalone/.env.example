VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# اختياري — يظهر في الترويسة إن تعذّر جلب الإعدادات
# VITE_SCHOOL_NAME=متوسطة وثانوية نخبة الشمال الأهلية

# خادم واتساب — له أولوية على إعدادات Supabase
# للتطوير المحلي إذا كان واتساب يعمل على جهازك:
# VITE_WHATSAPP_API_BASE=http://127.0.0.1:3001
# للإنتاج عبر Caddy (مُوصى به):
# VITE_WHATSAPP_API_BASE=https://control0.northelite0.com/api/whatsapp
# أو دومين واتساب مباشر إن وُجد:
# VITE_WHATSAPP_API_BASE=https://wpp.northelite0.com
